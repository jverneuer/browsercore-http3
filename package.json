{
  "name": "@browsercore/http3",
  "version": "0.1.3",
  "description": "HTTP/3 framing + QPACK over QUIC streams. No knowledge of UDP, QUIC internals, or TLS \u2014 only HTTP/3 wire format over a QUIC connection.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/browsercore-http3.git"
  },
  "homepage": "https://github.com/jverneuer/browsercore-http3#readme",
  "bugs": {
    "url": "https://github.com/jverneuer/browsercore-http3/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browsercore/quic": "latest"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
